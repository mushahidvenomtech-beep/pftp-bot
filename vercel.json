{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/embed.js",
      "dest": "/embed.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/chatbot/assets/(.*)",
      "dest": "/chatbot/assets/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/chatbot/admin/assets/(.*)",
      "dest": "/chatbot/admin/assets/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/chatbot/assets/images/pftp-logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
